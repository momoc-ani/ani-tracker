{
  "name": "ani-tracker",
  "version": "0.1.0",
  "description": "A local anime tracking, release matching, and download manager.",
  "author": "Ani Tracker contributors",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:tauri",
    "build": "pnpm run build:tauri",
    "package:desktop": "pnpm run package:tauri:desktop",
    "build:torrent-core": "cmake --preset release -S native/torrent-core && cmake --build native/torrent-core/build/release --config Release",
    "build:torrent-core:portable": "cmake --preset portable-release -S native/torrent-core && cmake --build native/torrent-core/build/portable-release --config Release",
    "bundle:torrent-core": "node scripts/package-torrent-core-bundle.mjs",
    "prepare:desktop-torrent-core-dev": "node scripts/prepare-desktop-torrent-core-dev.mjs",
    "prepare:torrent-core:android": "bash scripts/prepare-android-torrent-dependencies.sh",
    "prepare:torrent-core:ios": "bash scripts/prepare-ios-torrent-core.sh",
    "manifest:torrent-core": "node scripts/create-torrent-core-manifest.mjs",
    "prepare:torrent-core": "node scripts/prepare-torrent-core-resources.mjs",
    "verify:torrent-core": "node scripts/prepare-torrent-core-resources.mjs --required --verify-only",
    "verify:torrent-core:all": "node scripts/prepare-torrent-core-resources.mjs --verify-all",
    "prepare:qbittorrent": "node scripts/prepare-qbittorrent-resources.mjs",
    "verify:qbittorrent": "node scripts/prepare-qbittorrent-resources.mjs --required",
    "smoke:qbittorrent:managed": "node scripts/smoke-managed-qbittorrent.mjs",
    "prepare:qbittorrent:sources": "node scripts/prepare-qbittorrent-build-sources.mjs",
    "build:qbittorrent:nox:unix": "bash scripts/build-qbittorrent-nox-unix.sh",
    "build:qbittorrent:nox:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-qbittorrent-nox-windows.ps1",
    "bundle:qbittorrent:nox": "node scripts/package-qbittorrent-bundle.mjs",
    "verify:qbittorrent:bundle": "node scripts/verify-qbittorrent-bundle.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-resources.mjs",
    "prepare:rife-sidecar": "node scripts/prepare-rife-model-sidecar.mjs",
    "verify:rife-sidecar": "node scripts/prepare-rife-model-sidecar.mjs --verify-only",
    "prepare:realesrgan-sidecar": "node scripts/prepare-realesrgan-model-sidecar.mjs",
    "verify:realesrgan-sidecar": "node scripts/prepare-realesrgan-model-sidecar.mjs --verify-only",
    "verify:pc-enhancement-resources": "node scripts/verify-pc-enhancement-resources.mjs",
    "verify:ffmpeg": "node scripts/prepare-ffmpeg-resources.mjs --verify-all",
    "download:ffmpeg": "node scripts/download-ffmpeg-resources.mjs --all",
    "prepare:tauri:win-libmpv": "node scripts/prepare-windows-libmpv-dev.mjs",
    "prepare:tauri:mac-libmpv": "node scripts/prepare-macos-libmpv-dev.mjs",
    "prepare:tauri:linux-deps": "node scripts/prepare-linux-desktop-dependencies.mjs",
    "prepare:tauri:ios-libvlc": "bash scripts/prepare-ios-libvlc.sh",
    "verify:libmpv": "node scripts/verify-desktop-libmpv-runtime.mjs",
    "prepare:tauri:desktop-runtime": "node scripts/prepare-tauri-desktop-runtime.mjs",
    "sync:tauri:mobile-brand": "node scripts/sync-tauri-mobile-brand-assets.mjs",
    "dev:tauri": "pnpm run prepare:tauri:desktop-runtime && tauri dev --config src-tauri/tauri.remote.conf.json",
    "dev:tauri:renderer": "vite --config vite.tauri.config.ts",
    "build:tauri": "pnpm run prepare:tauri:desktop-runtime && tauri build --no-bundle --config src-tauri/tauri.remote.conf.json",
    "package:tauri:desktop": "pnpm run prepare:tauri:desktop-runtime && tauri build --ci --config src-tauri/tauri.remote.conf.json && pnpm run verify:tauri:renderer-boundaries",
    "build:tauri:renderer": "vite build --config vite.tauri.config.ts",
    "build:tauri:remote-renderer": "vite build --config vite.remote.config.ts",
    "build:tauri:desktop-renderers": "pnpm run build:tauri:renderer && pnpm run build:tauri:remote-renderer && pnpm run verify:tauri:renderer-boundaries",
    "dev:tauri:android": "pnpm run sync:tauri:mobile-brand -- --platform android && tauri android dev",
    "sync:tauri:ios-target": "node scripts/sync-tauri-ios-deployment-target.mjs",
    "init:tauri:ios": "tauri ios init --ci && pnpm run sync:tauri:ios-target && pnpm run sync:tauri:mobile-brand -- --platform ios",
    "dev:tauri:ios": "pnpm run sync:tauri:ios-target && pnpm run sync:tauri:mobile-brand -- --platform ios && tauri ios dev",
    "package:tauri:android:debug": "pnpm run sync:tauri:mobile-brand -- --platform android && pnpm run prepare:torrent-core:android && tauri android build --target aarch64 --debug --apk --ci && pnpm run verify:tauri:renderer-boundaries -- --renderer local && pnpm run verify:tauri:android-package",
    "package:tauri:android": "pnpm run sync:tauri:mobile-brand -- --platform android && pnpm run prepare:torrent-core:android && tauri android build --target aarch64 --apk --ci && pnpm run verify:tauri:renderer-boundaries -- --renderer local && pnpm run verify:tauri:android-package",
    "package:tauri:ios": "pnpm run sync:tauri:ios-target && pnpm run sync:tauri:mobile-brand -- --platform ios && pnpm run prepare:torrent-core:ios && pnpm run prepare:tauri:ios-libvlc && tauri ios build --target aarch64 --ci --no-sign && bash scripts/package-unsigned-ios-ipa.sh && pnpm run verify:tauri:renderer-boundaries -- --renderer local && pnpm run verify:tauri:ios-package -- --require-unsigned",
    "verify:tauri:android-package": "pnpm run sync:tauri:mobile-brand -- --platform android --check && node scripts/verify-tauri-mobile-package.mjs --platform android",
    "verify:tauri:ios-package": "pnpm run sync:tauri:mobile-brand -- --platform ios --check && node scripts/verify-tauri-mobile-package.mjs --platform ios",
    "verify:tauri:renderer-boundaries": "pnpm run verify:tauri:retired-hosts && node scripts/verify-renderer-boundaries.mjs",
    "verify:tauri:retired-hosts": "node scripts/verify-retired-host-boundaries.mjs",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "test:mobile-package": "node --test scripts/sync-tauri-mobile-brand-assets.test.mjs scripts/verify-tauri-mobile-package.test.mjs scripts/verify-tauri-mobile-workflows.test.mjs",
    "test:desktop-gates": "node --test scripts/prepare-macos-libmpv-dev.test.mjs scripts/prepare-qbittorrent-resources.test.mjs scripts/prepare-realesrgan-model-sidecar.test.mjs scripts/prepare-rife-model-sidecar.test.mjs scripts/prepare-tauri-gate-resources.test.mjs scripts/prepare-windows-libmpv-dev.test.mjs scripts/verify-desktop-libmpv-runtime.test.mjs scripts/verify-tauri-desktop-workflow.test.mjs scripts/verify-pc-enhancement-resources.test.mjs",
    "test:player-matrix": "node --test scripts/player-enhancement-matrix.test.mjs",
    "test:retired-hosts": "node --test scripts/verify-retired-host-boundaries.test.mjs",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "release:set-version": "node scripts/set-tauri-release-version.mjs",
    "release:manifest": "node scripts/create-tauri-release-manifest.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.typecheck.node.json --pretty false && tsc -p tsconfig.typecheck.web.json --pretty false",
    "test:parsers": "node scripts/run-node-tests.mjs",
    "test:theme": "node scripts/verify-theme-contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "artplayer": "5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.53.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@webgpu/types": "0.1.61",
    "autoprefixer": "^10.4.20",
    "https-proxy-agent": "^7.0.6",
    "postcss": "^8.4.47",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
